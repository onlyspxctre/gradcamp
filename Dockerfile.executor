FROM alpine:edge

RUN rm -rf /sbin/apk /etc/apk /lib/apk /var/cache/apk/*

# strip SUID and SGID permissions across the image
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

RUN adduser -D -u 1000 -s /bin/sh evaluator && \
    adduser -D -u 1001 -s /bin/false driver && \
    mkdir -p /workspace/bin /workspace/tests /workspace/out && \
    chown -R evaluator:evaluator /workspace/tests /workspace/out && \
    chmod 0700 /workspace/tests /workspace/out

COPY executor.sh /usr/local/bin/executor.sh
RUN chmod 0755 /usr/local/bin/executor.sh

# 5. Drop privileges
USER evaluator
WORKDIR /workspace

ENV TMPDIR=/tmp \
    BIN_PATH=/workspace/evaluator \
    TESTS_DIR=/workspace/tests \
    TIMEOUT_SEC=2 \
    MAX_OUTPUT_BYTES=1048576 \
    RESULTS_FILE=/tmp/results.json

ENTRYPOINT ["/usr/local/bin/executor.sh"]
