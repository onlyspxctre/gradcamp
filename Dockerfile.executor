FROM alpine:edge AS builder

RUN apk add --no-cache build-base pkgconf yyjson-dev yyjson-static
COPY evaluator/evaluator.c /src/evaluator.c
RUN gcc -static -O2 -Wall -Wextra -o /evaluator /src/evaluator.c $(pkg-config --cflags --libs yyjson)

FROM alpine:edge

RUN rm -rf /sbin/apk /etc/apk /lib/apk /var/cache/apk/*

# strip SUID and SGID permissions across the image
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

RUN adduser -D -u 1000 -s /bin/sh evaluator && \
    mkdir -p /workspace/bin /workspace/out && \
    chown evaluator:evaluator /workspace/out && \
    chmod 0700 /workspace/out

COPY --from=builder /evaluator /usr/local/bin/evaluator

# Run as the unprivileged evaluator user
USER evaluator
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/evaluator"]
CMD ["/workspace/tests.json", "/workspace/out/results.json"]
